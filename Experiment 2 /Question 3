Write a program for student class implementation :

public class student {
    String name;
    int rollno;
    String department;
    double marks;

    student () {
        name = "Suraj";
        rollno = 18;
        department = "CSE";
        marks = 85.5;
    }

    student (String n, int r, String d, double m) {
        name = n;
        rollno = r;
        department = d;
        marks = m;
    }

    student (student s) {
        name = s.name;
        rollno = s.rollno;
        department = s.department;
        marks = s.marks;
    }

    void display () {
        System.out.println("Name = "+name);
        System.out.println("Roll no"+rollno);
        System.out.println("Department = "+department);
        System.out.println("Marks : "+marks);
    }

    public static void main (String args[]) {
        student s1 = new student ();
        student s2 = new student (2, "Anthony", "Polytechnic", 93);
        student s3 = new student (s1);
        
        s1.display ();
        s2.display ();
        s3.display ();
    }
}

Output:
Name: Ram
Roll no: 18
Department: Polytechnic
Marks: 98
